{
  "name": "ip-tracker",
  "version": "2.0.0",
  "description": "Rastreador de IPs — CLI Admin completo",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "admin": "node admin-cli.js",
    "build": "pkg server.js --targets node18-win-x64 --output dist/ip-tracker-server.exe && pkg admin-cli.js --targets node18-win-x64 --output dist/ip-tracker-admin.exe"
  },
  "pkg": {
    "assets": [
      "visits.json",
      "blacklist.json",
      "config.json",
      "index.html",
      "admin.html",
      "backups"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "dependencies": {
    "axios": "^1.16.1",
    "chalk": "^4.1.2",
    "cookie-parser": "^1.4.7",
    "crypto": "^1.0.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "node-fetch": "^2.7.0",
    "qrcode-terminal": "^0.12.0",
    "ua-parser-js": "^2.0.9"
  }
}
